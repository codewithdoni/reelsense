# --- required ---------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- video understanding (either one works; OpenRouter is tried first) -------
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- trend radar + competitor discovery (optional) ---------------------------
EXA_API_KEY=

# --- comment-to-DM automation ------------------------------------------------
# From developers.facebook.com -> your app -> Instagram -> API setup with
# Instagram login -> "Generate token" for your own Creator/Business account.
# Scopes: instagram_business_basic, instagram_business_manage_comments,
#         instagram_business_manage_messages
IG_TOKEN=
IG_USER_ID=
IG_POLL_SECONDS=10

# --- optional overrides ------------------------------------------------------
REELSENSE_MODEL=gpt-5.6-terra
REELSENSE_FALLBACK_MODELS=gpt-5.6-luna,gpt-4o
REELSENSE_VIDEO_MODEL=google/gemini-2.5-flash
REELSENSE_GEMINI_MODEL=gemini-2.5-flash
