# --- the agents' model -------------------------------------------------------
# The four agents run on any OpenAI-protocol provider. Set ONE of the keys
# below; the first one found wins, or name it explicitly with LLM_PROVIDER.
#
#   openai      — needs a real API key (a ChatGPT or Codex subscription is not one)
#   gemini      — free tier, OpenAI-compatible endpoint
#   openrouter  — pay per call, any model
#
LLM_PROVIDER=

OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Override the model if you want something other than the provider's default
# (openai: gpt-5.6-terra · gemini: gemini-2.5-flash · openrouter: google/gemini-2.5-flash)
REELSENSE_MODEL=
REELSENSE_FALLBACK_MODELS=

# --- watching reel video -----------------------------------------------------
# Uses GEMINI_API_KEY or OPENROUTER_API_KEY from above. Without either, reels
# are analysed from caption and metrics only and the panel says so.
REELSENSE_VIDEO_MODEL=google/gemini-2.5-flash
REELSENSE_GEMINI_MODEL=gemini-2.5-flash

# --- trend radar + competitor discovery (optional) ---------------------------
EXA_API_KEY=

# --- comment-to-DM automation ------------------------------------------------
# developers.facebook.com -> your app -> Instagram -> API setup with Instagram
# login -> "Generate token" for your own Creator/Business account.
# Scopes: instagram_business_basic, instagram_business_manage_comments,
#         instagram_business_manage_messages
IG_TOKEN=
IG_USER_ID=
IG_POLL_SECONDS=10
